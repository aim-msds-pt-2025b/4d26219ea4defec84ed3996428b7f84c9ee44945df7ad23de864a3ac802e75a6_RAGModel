# Environment variables for Airflow Docker Compose setup
# TEMPLATE FILE - Copy to .env.local for local development
#
# Set the Airflow UID to match your user (for Linux/Mac)
# On Windows, this can remain as default
COMPOSE_PROJECT_NAME=news-classifier
AIRFLOW_UID=50000

# Airflow web UI credentials (change for production!)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Project directory (should be set to current directory)
AIRFLOW_PROJ_DIR=.

# Additional Python packages (if needed)
_PIP_ADDITIONAL_REQUIREMENTS=

# Timezone setting
TZ=UTC
